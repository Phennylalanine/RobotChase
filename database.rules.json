{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).exists()",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 16"
          }
        },
        "subs": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('state/phase').val() === 'play'",
            ".validate": "newData.child('n').isNumber() && newData.child('q').isNumber() && newData.child('choice').isNumber()"
          }
        },
        "pos": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('state/phase').val() === 'bonus'",
            ".validate": "newData.child('x').isNumber() && newData.child('y').isNumber()"
          }
        },
        "safe": {
          "$w": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($code).child('state/phase').val() === 'bonus'"
            }
          }
        }
      }
    }
  }
}